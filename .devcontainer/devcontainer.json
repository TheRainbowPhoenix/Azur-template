{
  "name": "Azur ClassPad app",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },
  "postCreateCommand": "git submodule update --init --recursive && bash scripts/setup-azur.sh",
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "clangd.path": "/usr/bin/clangd"
      },
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  },
  "containerEnv": {
    "TMPDIR": "/home/dev/tmp/"
  }
}

